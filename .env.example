# Copia este archivo a .env.local y completa los valores del proyecto Supabase del entorno.
# Nunca pongas aquí claves secretas (sb_secret_… / service_role): todo NEXT_PUBLIC_* llega al navegador.

# URL del proyecto Supabase (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=
# Clave publicable (sb_publishable_…). Es pública por diseño; RLS protege los datos.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# URL pública de la app; se usa para enlaces de invitación y redirecciones de Auth.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web Push: solo la clave VAPID pública (opcional). Requiere configurar primero
# el emisor de servidor; el Hito C mantiene avisos visuales sin esta variable.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Solo para scripts de configuración (nunca con prefijo NEXT_PUBLIC_) ---
# Supabase Auth con SMTP propio y códigos OTP de 8 dígitos: npm run auth:configure -- --diff | --apply | --verify
# Ref del proyecto al que se aplicará la configuración (debe coincidir con la URL y con `supabase link`).
AUTH_PROJECT_REF=
# URL del sitio y redirecciones permitidas (separadas por comas). HTTP solo para localhost.
AUTH_SITE_URL=http://localhost:3000
AUTH_REDIRECT_URLS=http://localhost:3000/**
# SMTP del buzón remitente (Hostinger: smtp.hostinger.com, puerto 465).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
AUTH_EMAIL_FROM=
AUTH_EMAIL_SENDER_NAME=Centro Familiar
